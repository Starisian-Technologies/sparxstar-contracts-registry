{
  "contract": "sparxstar-3iatlas-identity-node/key-vault-grant",
  "version": "1.0.0",
  "description": "Shared conformance vectors for the Identity <-> Key Vault grant contract. ONE suite, run by BOTH sides: Identity against grant issuance, the Key Vault against grant verification. Two suites that agree today are the arrangement this replaces.",
  "reference_time": 1767225600,
  "reference_time_note": "All iat/nbf/exp are absolute seconds against this fixed instant. A runner evaluates cases as if now == reference_time, so vectors never expire and never flake.",
  "sides": {
    "issuer": "Identity Node \u2014 must REFUSE TO MINT a rejected case.",
    "verifier": "Key Vault \u2014 must REFUSE TO ACCEPT a rejected case, leaving stored key material unchanged."
  },
  "stored_state": {
    "accountRef": "acct-1",
    "manifestVersion": 5,
    "generations": [
      1,
      2
    ]
  },
  "universal_assertion": "On every reject, stored key material is unchanged. No partial mutation, no best-effort completion: a refused request is indistinguishable from one that never arrived.",
  "cases": [
    {
      "id": "accept-read",
      "description": "Minimal valid read grant.",
      "route": {
        "op": "manifest-read",
        "accountRef": "acct-1"
      },
      "claims": {
        "iss": "identity-node",
        "aud": "key-vault",
        "sub": "acct-1",
        "jti": "jti-1",
        "iat": 1767225600,
        "nbf": 1767225600,
        "exp": 1767225900,
        "op": "manifest-read"
      },
      "expect": "accept",
      "reason": "All required claims present; aud scalar; op matches route.",
      "sides": [
        "issuer",
        "verifier"
      ]
    },
    {
      "id": "accept-rotate",
      "description": "Rotate grant with both conditional claims.",
      "route": {
        "op": "manifest-rotate",
        "accountRef": "acct-1"
      },
      "claims": {
        "iss": "identity-node",
        "aud": "key-vault",
        "sub": "acct-1",
        "jti": "jti-rot",
        "iat": 1767225600,
        "nbf": 1767225600,
        "exp": 1767225900,
        "op": "manifest-rotate",
        "expectedVersion": 4,
        "txId": "tx-1"
      },
      "expect": "accept",
      "reason": "manifest-rotate carries expectedVersion and txId; exp-iat is exactly 300.",
      "sides": [
        "issuer",
        "verifier"
      ]
    },
    {
      "id": "accept-recover",
      "description": "Generation recovery names the exact generation.",
