      "claims": {
        "iss": "identity-node",
        "aud": "key-vault",
        "sub": "acct-1",
        "jti": "jti-rec",
        "iat": 1767225600,
        "nbf": 1767225600,
        "exp": 1767225900,
        "op": "manifest-generation-recover",
        "generation": 2
      },
      "expect": "accept",
      "reason": "generation present and exact.",
      "sides": [
        "issuer",
        "verifier"
      ]
    },
    {
      "id": "accept-prov-replace",
