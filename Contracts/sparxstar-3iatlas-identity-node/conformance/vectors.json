        "exp": 1767226500,
        "op": "manifest-read"
      },
      "expect": "accept",
      "reason": "The 300s ceiling binds destructive operations. Read grants are multi-use within a short expiry.",
      "sides": [
        "issuer",
        "verifier"
      ]
    },
