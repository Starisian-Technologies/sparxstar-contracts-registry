        "op": "manifest-provisioning-replace",
        "accountRef": "acct-1"
      },
      "claims": {
        "iss": "identity-node",
        "aud": "key-vault",
        "sub": "acct-1",
        "jti": "jti-pr",
        "iat": 1767225600,
        "nbf": 1767225600,
